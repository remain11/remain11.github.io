---
import type { ZhihuPost } from '../data/zhihu';

interface Props {
  post: ZhihuPost;
  description?: string;
}

const {
  post,
  description = '记录 CS:APP 各章节实验的实现思路、调试过程与踩坑总结。',
} = Astro.props;
---

<a
  class="column-card"
  href={post.url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`知乎专栏：${post.title}`}
>
  <div class="column-cover-wrap">
    <img
      class="column-cover"
      src={post.cover}
      alt=""
      width="1200"
      height="675"
      decoding="async"
    />
  </div>
  <div class="column-body">
    <div class="zhihu-meta">
      <span class="zhihu-badge">知乎专栏</span>
      {post.date && <span>{post.date}</span>}
    </div>
    <h3 class="column-title">{post.title}</h3>
    <p class="column-desc">{description}</p>
    <span class="column-more">进入专栏 <span aria-hidden="true">↗</span></span>
  </div>
</a>
